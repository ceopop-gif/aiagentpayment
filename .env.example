# AnnyPay runtime
PORT=3000

# Public frontend/Supabase project values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase value — NEVER expose in browser or commit a real value
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server secret encryption key: base64 encoded 32 random bytes
ANNYPAY_MASTER_KEY=YOUR_BASE64_32_BYTE_MASTER_KEY

# Unified Audit Logging
# Used to HMAC-hash client IP before storage. If blank, no IP hash is stored.
LOG_IP_HASH_KEY=YOUR_LONG_RANDOM_LOG_HASH_KEY
# Optional persistent JSONL path on hosts with durable disk. Stdout JSON logs are always emitted.
ANNYPAY_LOG_FILE=

# Provider-neutral AI Gateway contract
AI_GATEWAY_URL=https://your-ai-gateway.example
AI_GATEWAY_API_KEY=YOUR_AI_GATEWAY_SECRET
AI_MODEL=YOUR_MODEL_NAME
AI_DEFAULT_MAX_OUTPUT_TOKENS=1200

# Commerce Payment Provider
PAYMENT_PROVIDER=YOUR_PROVIDER_NAME
PAYMENT_API_BASE_URL=https://api.provider.example
PAYMENT_API_KEY=YOUR_SERVER_SIDE_API_KEY
PAYMENT_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Optional normalized Payout Provider Adapter
# Disabled unless PAYOUT_ADAPTER_TYPE=hmac-http
PAYOUT_ADAPTER_TYPE=
PAYOUT_PROVIDER=YOUR_PAYOUT_PROVIDER_NAME
PAYOUT_API_BASE_URL=https://payout.provider.example
PAYOUT_API_KEY=YOUR_PAYOUT_SERVER_KEY
PAYOUT_WEBHOOK_SECRET=YOUR_PAYOUT_WEBHOOK_SECRET
PAYOUT_VERIFY_ACCOUNT_PATH=/beneficiaries/verify
PAYOUT_CREATE_PATH=/payouts
PAYOUT_STATUS_PATH=/payouts/{id}
PAYOUT_SIGNATURE_HEADER=x-signature

# Never put server secrets, raw IP, full bank account numbers,
# access tokens or credentials in config.js/client code.
